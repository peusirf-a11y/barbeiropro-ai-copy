{
  "name": "Professional",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "unit_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs das unidades onde este profissional atende. Vazio = aparece em todas (compatibilidade com mono-unidade)."
    },
    "name": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "specialty": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "work_schedule": {
      "type": "object"
    },
    "service_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "commission_type": {
      "type": "string",
      "enum": [
        "percent",
        "fixed"
      ]
    },
    "commission_value": {
      "type": "number"
    },
    "bio_short": {
      "type": "string",
      "description": "Biografia curta gerada por IA (at\u00e9 150 caracteres). Edit\u00e1vel pela barbearia."
    },
    "bio_medium": {
      "type": "string",
      "description": "Biografia m\u00e9dia gerada por IA (at\u00e9 300 caracteres). Edit\u00e1vel pela barbearia."
    },
    "bio_full": {
      "type": "string",
      "description": "Biografia completa gerada por IA (at\u00e9 600 caracteres). Edit\u00e1vel pela barbearia."
    },
    "bio_generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Quando a IA gerou a biografia pela \u00faltima vez."
    },
    "bio_source_signature": {
      "type": "string",
      "description": "Assinatura dos dados usados na \u00faltima gera\u00e7\u00e3o (nome, especialidade, servi\u00e7os, marco de atendimentos, avalia\u00e7\u00f5es). Quando muda, sugere regerar."
    }
  },
  "required": [
    "company_id",
    "name"
  ]
}
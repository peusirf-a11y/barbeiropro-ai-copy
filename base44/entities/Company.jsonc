{
  "name": "Company",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "primary_color": {
      "type": "string",
      "default": "#1B3A4B"
    },
    "secondary_color": {
      "type": "string",
      "default": "#F8F7F3"
    },
    "slug": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "whatsapp": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "business_hours": {
      "type": "object"
    },
    "status": {
      "type": "string",
      "enum": [
        "trial",
        "active",
        "inactive",
        "blocked"
      ],
      "default": "trial"
    },
    "plan_name": {
      "type": "string",
      "default": "Starter"
    },
    "plan_id": {
      "type": "string",
      "description": "Refer\u00eancia \u00e0 entity Plan (fonte da verdade para pre\u00e7o/MRR/features)"
    },
    "onboarding_step": {
      "type": "number",
      "default": 1
    },
    "onboarding_completed": {
      "type": "boolean",
      "default": false
    },
    "owner_email": {
      "type": "string"
    },
    "owner_name": {
      "type": "string"
    },
    "stripe_customer_id": {
      "type": "string"
    },
    "stripe_subscription_id": {
      "type": "string"
    },
    "stripe_price_id": {
      "type": "string"
    },
    "subscription_status": {
      "type": "string",
      "enum": [
        "trialing",
        "active",
        "past_due",
        "canceled",
        "incomplete",
        "unpaid"
      ],
      "description": "Status da assinatura no Stripe"
    },
    "trial_ends_at": {
      "type": "string",
      "format": "date-time"
    },
    "current_period_end": {
      "type": "string",
      "format": "date-time"
    },
    "is_blocked_by_billing": {
      "type": "boolean",
      "default": false,
      "description": "Bloqueio autom\u00e1tico por inadimpl\u00eancia"
    },
    "trial_email_d3_sent": {
      "type": "boolean",
      "default": false
    },
    "trial_email_d1_sent": {
      "type": "boolean",
      "default": false
    },
    "multi_unit_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Liga o recurso de multi-unidade."
    },
    "customers_shared_across_units": {
      "type": "boolean",
      "default": true,
      "description": "Quando true, clientes pertencem \u00e0 barbearia inteira."
    },
    "units_backfilled_at": {
      "type": "string",
      "format": "date-time",
      "description": "Marcador idempotente do backfill da Matriz."
    },
    "stripe_connect_account_id": {
      "type": "string",
      "description": "ID da conta Stripe Connect Express da barbearia (ex: acct_xxx). Recebe os pagamentos do link p\u00fablico."
    },
    "stripe_connect_status": {
      "type": "string",
      "enum": [
        "pending",
        "enabled",
        "disabled"
      ],
      "description": "Status do onboarding Connect: pending=criada mas precisa completar; enabled=charges_enabled; disabled=desativada."
    },
    "stripe_connect_charges_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Se a conta conectada j\u00e1 pode receber cobran\u00e7as."
    },
    "stripe_connect_payouts_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Se a conta conectada j\u00e1 pode receber payouts."
    },
    "whatsapp_settings": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "send_confirmation": {
          "type": "boolean",
          "default": true
        },
        "send_reminder_24h": {
          "type": "boolean",
          "default": true
        },
        "send_reminder_2h": {
          "type": "boolean",
          "default": true
        },
        "send_post_appointment": {
          "type": "boolean",
          "default": true
        },
        "send_reactivation": {
          "type": "boolean",
          "default": true
        },
        "reactivation_days": {
          "type": "number",
          "default": 30
        },
        "send_window_start": {
          "type": "string",
          "default": "09:00"
        },
        "send_window_end": {
          "type": "string",
          "default": "20:00"
        },
        "review_link": {
          "type": "string"
        },
        "msg_confirmation": {
          "type": "string",
          "default": "Ol\u00e1, {nome}! Seu hor\u00e1rio na {barbearia} foi confirmado para {data} \u00e0s {hora}. Te esperamos! \ud83d\udc88"
        },
        "msg_reminder_24h": {
          "type": "string",
          "default": "Fala, {nome}! Passando pra lembrar do seu hor\u00e1rio amanh\u00e3 \u00e0s {hora} na {barbearia}. \ud83d\udc88"
        },
        "msg_reminder_2h": {
          "type": "string",
          "default": "Opa {nome}! Seu hor\u00e1rio na {barbearia} \u00e9 daqui 2h, \u00e0s {hora}. T\u00f4 te esperando! \ud83d\udc88"
        },
        "msg_post_appointment": {
          "type": "string",
          "default": "Valeu por colar na {barbearia}, {nome}! \ud83d\udd25 Se puder, deixa sua avalia\u00e7\u00e3o: {link_avaliacao}"
        },
        "msg_reactivation": {
          "type": "string",
          "default": "Fala, {nome}! Sumiu hein \ud83d\udc40 J\u00e1 t\u00e1 na hora de dar aquele trato! Quer que eu veja um hor\u00e1rio pra voc\u00ea essa semana?"
        }
      }
    }
  },
  "required": [
    "name"
  ]
}
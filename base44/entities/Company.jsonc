{
  "name": "Company",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "primary_color": {
      "type": "string",
      "default": "#1B3A4B"
    },
    "secondary_color": {
      "type": "string",
      "default": "#F8F7F3"
    },
    "slug": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "whatsapp": {
      "type": "string"
    },
    "address": {
      "type": "string",
      "description": "Endere\u00e7o em texto livre (legacy). Mantido para compatibilidade. Para dados estruturados, ver address_details."
    },
    "address_details": {
      "type": "object",
      "description": "Endere\u00e7o estruturado coletado no onboarding e usado para pr\u00e9-preencher o KYC do Stripe Connect.",
      "properties": {
        "line1": {
          "type": "string",
          "description": "Rua e n\u00famero"
        },
        "line2": {
          "type": "string",
          "description": "Complemento (opcional)"
        },
        "neighborhood": {
          "type": "string",
          "description": "Bairro"
        },
        "city": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "description": "UF (sigla, ex: SP)"
        },
        "postal_code": {
          "type": "string",
          "description": "CEP (somente d\u00edgitos)"
        },
        "country": {
          "type": "string",
          "default": "BR"
        }
      }
    },
    "business_type": {
      "type": "string",
      "enum": [
        "mei",
        "cnpj",
        "individual"
      ],
      "description": "Tipo de neg\u00f3cio para Stripe Connect: mei/cnpj=company, individual=pessoa f\u00edsica."
    },
    "business_hours": {
      "type": "object"
    },
    "status": {
      "type": "string",
      "enum": [
        "trial",
        "active",
        "inactive",
        "blocked"
      ],
      "default": "trial"
    },
    "plan_name": {
      "type": "string",
      "default": "Starter"
    },
    "plan_id": {
      "type": "string",
      "description": "Refer\u00eancia \u00e0 entity Plan (fonte da verdade para pre\u00e7o/MRR/features)"
    },
    "onboarding_step": {
      "type": "number",
      "default": 1
    },
    "onboarding_completed": {
      "type": "boolean",
      "default": false
    },
    "owner_email": {
      "type": "string"
    },
    "owner_name": {
      "type": "string"
    },
    "stripe_customer_id": {
      "type": "string"
    },
    "stripe_subscription_id": {
      "type": "string"
    },
    "stripe_price_id": {
      "type": "string"
    },
    "subscription_status": {
      "type": "string",
      "enum": [
        "trialing",
        "active",
        "past_due",
        "canceled",
        "incomplete",
        "unpaid"
      ],
      "description": "Status da assinatura no Stripe"
    },
    "trial_ends_at": {
      "type": "string",
      "format": "date-time"
    },
    "current_period_end": {
      "type": "string",
      "format": "date-time"
    },
    "is_blocked_by_billing": {
      "type": "boolean",
      "default": false,
      "description": "Bloqueio autom\u00e1tico por inadimpl\u00eancia"
    },
    "trial_email_d3_sent": {
      "type": "boolean",
      "default": false
    },
    "trial_email_d1_sent": {
      "type": "boolean",
      "default": false
    },
    "multi_unit_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Liga o recurso de multi-unidade."
    },
    "customers_shared_across_units": {
      "type": "boolean",
      "default": true,
      "description": "Quando true, clientes pertencem \u00e0 barbearia inteira."
    },
    "units_backfilled_at": {
      "type": "string",
      "format": "date-time",
      "description": "Marcador idempotente do backfill da Matriz."
    },
    "stripe_connect_account_id": {
      "type": "string",
      "description": "ID da conta Stripe Connect Express da barbearia (ex: acct_xxx). Recebe os pagamentos do link p\u00fablico."
    },
    "stripe_connect_status": {
      "type": "string",
      "enum": [
        "pending",
        "enabled",
        "disabled"
      ],
      "description": "Status do onboarding Connect: pending=criada mas precisa completar; enabled=charges_enabled; disabled=desativada."
    },
    "stripe_connect_charges_enabled": {
      "type": "boolean",
      "default": false
    },
    "stripe_connect_payouts_enabled": {
      "type": "boolean",
      "default": false
    },
    "stripe_connect_pix_enabled": {
      "type": "boolean",
      "default": false
    },
    "whatsapp_settings": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "send_confirmation": {
          "type": "boolean",
          "default": true
        },
        "send_reminder_24h": {
          "type": "boolean",
          "default": true
        },
        "send_reminder_2h": {
          "type": "boolean",
          "default": true
        },
        "send_post_appointment": {
          "type": "boolean",
          "default": true
        },
        "send_reactivation": {
          "type": "boolean",
          "default": true
        },
        "reactivation_days": {
          "type": "number",
          "default": 30
        },
        "send_window_start": {
          "type": "string",
          "default": "09:00"
        },
        "send_window_end": {
          "type": "string",
          "default": "20:00"
        },
        "review_link": {
          "type": "string"
        },
        "msg_confirmation": {
          "type": "string",
          "default": "Ol\u00e1, {nome}! Seu hor\u00e1rio na {barbearia} foi confirmado para {data} \u00e0s {hora}. Te esperamos! \ud83d\udc88"
        },
        "msg_reminder_24h": {
          "type": "string",
          "default": "Fala, {nome}! Passando pra lembrar do seu hor\u00e1rio amanh\u00e3 \u00e0s {hora} na {barbearia}. \ud83d\udc88"
        },
        "msg_reminder_2h": {
          "type": "string",
          "default": "Opa {nome}! Seu hor\u00e1rio na {barbearia} \u00e9 daqui 2h, \u00e0s {hora}. T\u00f4 te esperando! \ud83d\udc88"
        },
        "msg_post_appointment": {
          "type": "string",
          "default": "Valeu por colar na {barbearia}, {nome}! \ud83d\udd25 Se puder, deixa sua avalia\u00e7\u00e3o: {link_avaliacao}"
        },
        "msg_reactivation": {
          "type": "string",
          "default": "Fala, {nome}! Sumiu hein \ud83d\udc40 J\u00e1 t\u00e1 na hora de dar aquele trato! Quer que eu veja um hor\u00e1rio pra voc\u00ea essa semana?"
        }
      }
    },
    "crm_settings": {
      "type": "object",
      "description": "Configura\u00e7\u00f5es do CRM inteligente \u2014 janelas (em dias) usadas para classificar o ciclo de vida dos clientes com base em last_completed_at.",
      "properties": {
        "fiel_min_appointments": {
          "type": "number",
          "default": 5,
          "description": "M\u00ednimo de atendimentos conclu\u00eddos para virar Cliente Fiel."
        },
        "em_risco_days": {
          "type": "number",
          "default": 30,
          "description": "Dias sem atendimento conclu\u00eddo para entrar em 'Em risco'."
        },
        "inativo_days": {
          "type": "number",
          "default": 60,
          "description": "Dias sem atendimento conclu\u00eddo para virar 'Inativo'."
        },
        "perdido_days": {
          "type": "number",
          "default": 90,
          "description": "Dias sem atendimento conclu\u00eddo para virar 'Perdido'."
        }
      }
    },
    "lifecycle_campaigns": {
      "type": "object",
      "description": "Campanhas autom\u00e1ticas de reten\u00e7\u00e3o baseadas em lifecycle_status. Cada campanha tem toggle, mensagem edit\u00e1vel (templates: {nome}, {barbearia}, {link_agendamento}) e cooldown configur\u00e1vel em dias. Quando enabled=true, o job runLifecycleCampaigns dispara mensagens eleg\u00edveis automaticamente.",
      "properties": {
        "primeira_visita": {
          "type": "object",
          "description": "Mensagem de boas-vindas enviada ~2h ap\u00f3s 1\u00aa visita conclu\u00edda (delay configur\u00e1vel).",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "delay_hours": {
              "type": "number",
              "default": 2,
              "description": "Quantas horas ap\u00f3s o atendimento conclu\u00eddo disparar."
            },
            "message": {
              "type": "string",
              "default": "Ea\u00ed {nome}, foi um prazer te receber na {barbearia} hoje! \ud83d\udd25 Esperamos te ver de volta em breve. Quando quiser marcar de novo, \u00e9 s\u00f3 chamar: {link_agendamento}"
            }
          }
        },
        "em_risco": {
          "type": "object",
          "description": "Reengajamento leve para clientes em risco (sumiram h\u00e1 ~30 dias).",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "cooldown_days": {
              "type": "number",
              "default": 14
            },
            "message": {
              "type": "string",
              "default": "Fala {nome}! Faz um tempinho que voc\u00ea n\u00e3o passa aqui na {barbearia} \ud83d\udc40 Bora marcar aquele trato? {link_agendamento}"
            }
          }
        },
        "inativo": {
          "type": "object",
          "description": "Tentativa de recupera\u00e7\u00e3o para clientes inativos (~60 dias).",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "cooldown_days": {
              "type": "number",
              "default": 30
            },
            "message": {
              "type": "string",
              "default": "Oi {nome}! Sentimos sua falta na {barbearia} \ud83d\udc88 Que tal voltar com a gente? Marca seu hor\u00e1rio: {link_agendamento}"
            }
          }
        },
        "perdido": {
          "type": "object",
          "description": "\u00daltima cartada para clientes considerados perdidos (~90+ dias).",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "cooldown_days": {
              "type": "number",
              "default": 60
            },
            "message": {
              "type": "string",
              "default": "{nome}, faz tempo n\u00e9? \ud83d\ude05 Se voc\u00ea quiser dar uma chance pra gente de novo, a {barbearia} t\u00e1 te esperando. Marca a\u00ed: {link_agendamento}"
            }
          }
        },
        "vip_inativo": {
          "type": "object",
          "description": "Alerta priorit\u00e1rio quando um cliente VIP entra em risco/inativo. Pode notificar o dono e/ou enviar mensagem direta ao cliente.",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "cooldown_days": {
              "type": "number",
              "default": 15
            },
            "alert_owner": {
              "type": "boolean",
              "default": true,
              "description": "Quando true, registra alerta para o dono ver no painel (n\u00e3o envia WhatsApp ao dono ainda)."
            },
            "message": {
              "type": "string",
              "default": "Oi {nome}! Faz um tempo que n\u00e3o te vemos por aqui e quer\u00edamos muito te receber de novo na {barbearia} \ud83d\udc51 Posso te garantir um hor\u00e1rio VIP essa semana? {link_agendamento}"
            }
          }
        },
        "fiel_sem_plano": {
          "type": "object",
          "description": "Sugest\u00e3o de assinatura para clientes fi\u00e9is que ainda n\u00e3o t\u00eam plano ativo.",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "cooldown_days": {
              "type": "number",
              "default": 45
            },
            "message": {
              "type": "string",
              "default": "Ea\u00ed {nome}! Como voc\u00ea \u00e9 cliente da casa aqui na {barbearia}, queria te oferecer nossos planos com desconto. Vale muito a pena, d\u00e1 uma olhada: {link_agendamento}"
            }
          }
        }
      }
    }
  },
  "required": [
    "name"
  ]
}
{
  "name": "Company",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "primary_color": {
      "type": "string",
      "default": "#1B3A4B"
    },
    "secondary_color": {
      "type": "string",
      "default": "#F8F7F3"
    },
    "slug": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "whatsapp": {
      "type": "string"
    },
    "address": {
      "type": "string",
      "description": "Endere\u00e7o em texto livre (legacy)."
    },
    "address_details": {
      "type": "object",
      "properties": {
        "line1": {
          "type": "string"
        },
        "line2": {
          "type": "string"
        },
        "neighborhood": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "postal_code": {
          "type": "string"
        },
        "country": {
          "type": "string",
          "default": "BR"
        }
      }
    },
    "business_type": {
      "type": "string",
      "enum": [
        "mei",
        "cnpj",
        "individual"
      ]
    },
    "business_hours": {
      "type": "object"
    },
    "status": {
      "type": "string",
      "enum": [
        "trial",
        "active",
        "inactive",
        "blocked"
      ],
      "default": "trial"
    },
    "plan_name": {
      "type": "string",
      "default": "Starter"
    },
    "plan_id": {
      "type": "string"
    },
    "feature_overrides": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "disabled": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "onboarding_step": {
      "type": "number",
      "default": 1
    },
    "onboarding_completed": {
      "type": "boolean",
      "default": false
    },
    "owner_email": {
      "type": "string"
    },
    "owner_name": {
      "type": "string"
    },
    "owner_cpf_cnpj": {
      "type": "string",
      "description": "CPF/CNPJ do respons\u00e1vel legal da barbearia."
    },
    "billing_provider": {
      "type": "string",
      "enum": [
        "stripe",
        "asaas",
        "asaas_pending"
      ],
      "default": "asaas",
      "description": "Provider ativo."
    },
    "asaas_customer_id": {
      "type": "string"
    },
    "asaas_subscription_id": {
      "type": "string"
    },
    "asaas_payment_link_url": {
      "type": "string"
    },
    "asaas_account_status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "blocked"
      ]
    },
    "asaas_pix_enabled": {
      "type": "boolean",
      "default": false
    },
    "asaas_subaccount_id": {
      "type": "string",
      "description": "ID da subaccount Asaas da barbearia (split autom\u00e1tico). Vazio = recebimento centralizado na conta master O CORTE."
    },
    "asaas_subaccount_wallet_id": {
      "type": "string",
      "description": "walletId da subaccount Asaas, usado no payload `split` de Payment/Subscription."
    },
    "asaas_subaccount_status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "rejected",
        "not_available_pf"
      ],
      "description": "Status do KYC da subaccount. 'not_available_pf' = barbearia \u00e9 Pessoa F\u00edsica (CPF); Asaas n\u00e3o permite subaccount, ent\u00e3o roda em modo manual."
    },
    "asaas_subaccount_api_key_preview": {
      "type": "string"
    },
    "asaas_subaccount_onboarding_url": {
      "type": "string"
    },
    "asaas_split_percentage": {
      "type": "number",
      "description": "Percentual repassado \u00e0 barbearia (0-100). Default 100."
    },
    "asaas_split_mode": {
      "type": "string",
      "enum": [
        "automatic",
        "manual"
      ],
      "description": "automatic = Asaas faz split direto na subaccount da barbearia. manual = recebimento centralizado na conta master O CORTE; repasse \u00e0 barbearia \u00e9 manual (PF/CPF n\u00e3o pode ter subaccount)."
    },
    "stripe_customer_id": {
      "type": "string"
    },
    "stripe_subscription_id": {
      "type": "string"
    },
    "stripe_price_id": {
      "type": "string"
    },
    "subscription_status": {
      "type": "string",
      "enum": [
        "trialing",
        "active",
        "past_due",
        "canceled",
        "incomplete",
        "unpaid"
      ]
    },
    "trial_ends_at": {
      "type": "string",
      "format": "date-time"
    },
    "current_period_end": {
      "type": "string",
      "format": "date-time"
    },
    "is_blocked_by_billing": {
      "type": "boolean",
      "default": false
    },
    "trial_email_d3_sent": {
      "type": "boolean",
      "default": false
    },
    "trial_email_d1_sent": {
      "type": "boolean",
      "default": false
    },
    "multi_unit_enabled": {
      "type": "boolean",
      "default": false
    },
    "customers_shared_across_units": {
      "type": "boolean",
      "default": true
    },
    "units_backfilled_at": {
      "type": "string",
      "format": "date-time"
    },
    "stripe_connect_account_id": {
      "type": "string"
    },
    "stripe_connect_status": {
      "type": "string",
      "enum": [
        "pending",
        "enabled",
        "disabled"
      ]
    },
    "stripe_connect_charges_enabled": {
      "type": "boolean",
      "default": false
    },
    "stripe_connect_payouts_enabled": {
      "type": "boolean",
      "default": false
    },
    "stripe_connect_pix_enabled": {
      "type": "boolean",
      "default": false
    },
    "migration_status": {
      "type": "string",
      "enum": [
        "not_migrated",
        "pending_first_payment",
        "migrated",
        "failed"
      ]
    },
    "stripe_pending_cancellation_at": {
      "type": "string",
      "format": "date-time"
    },
    "asaas_migration_started_at": {
      "type": "string",
      "format": "date-time"
    },
    "asaas_first_payment_confirmed_at": {
      "type": "string",
      "format": "date-time"
    },
    "whatsapp_settings": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "send_confirmation": {
          "type": "boolean",
          "default": true
        },
        "send_reminder_24h": {
          "type": "boolean",
          "default": true
        },
        "send_reminder_2h": {
          "type": "boolean",
          "default": true
        },
        "send_post_appointment": {
          "type": "boolean",
          "default": true
        },
        "send_reactivation": {
          "type": "boolean",
          "default": true
        },
        "reactivation_days": {
          "type": "number",
          "default": 30
        },
        "send_window_start": {
          "type": "string",
          "default": "09:00"
        },
        "send_window_end": {
          "type": "string",
          "default": "20:00"
        },
        "review_link": {
          "type": "string"
        },
        "msg_confirmation": {
          "type": "string",
          "default": "Ol\u00e1, {nome}! Seu hor\u00e1rio na {barbearia} foi confirmado para {data} \u00e0s {hora}. Te esperamos! \ud83d\udc88"
        },
        "msg_reminder_24h": {
          "type": "string",
          "default": "Fala, {nome}! Passando pra lembrar do seu hor\u00e1rio amanh\u00e3 \u00e0s {hora} na {barbearia}. \ud83d\udc88"
        },
        "msg_reminder_2h": {
          "type": "string",
          "default": "Opa {nome}! Seu hor\u00e1rio na {barbearia} \u00e9 daqui 2h, \u00e0s {hora}. T\u00f4 te esperando! \ud83d\udc88"
        },
        "msg_post_appointment": {
          "type": "string",
          "default": "Valeu por colar na {barbearia}, {nome}! \ud83d\udd25 Se puder, deixa sua avalia\u00e7\u00e3o: {link_avaliacao}"
        },
        "msg_reactivation": {
          "type": "string",
          "default": "Fala, {nome}! Sumiu hein \ud83d\udc40 J\u00e1 t\u00e1 na hora de dar aquele trato! Quer que eu veja um hor\u00e1rio pra voc\u00ea essa semana?"
        }
      }
    },
    "crm_settings": {
      "type": "object",
      "properties": {
        "fiel_min_appointments": {
          "type": "number",
          "default": 5
        },
        "em_risco_days": {
          "type": "number",
          "default": 30
        },
        "inativo_days": {
          "type": "number",
          "default": 60
        },
        "perdido_days": {
          "type": "number",
          "default": 90
        }
      }
    },
    "lifecycle_campaigns": {
      "type": "object",
      "properties": {
        "primeira_visita": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "delay_hours": {
              "type": "number",
              "default": 2
            },
            "message": {
              "type": "string"
            }
          }
        },
        "em_risco": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "cooldown_days": {
              "type": "number",
              "default": 14
            },
            "message": {
              "type": "string"
            }
          }
        },
        "inativo": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "cooldown_days": {
              "type": "number",
              "default": 30
            },
            "message": {
              "type": "string"
            }
          }
        },
        "perdido": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "cooldown_days": {
              "type": "number",
              "default": 60
            },
            "message": {
              "type": "string"
            }
          }
        },
        "vip_inativo": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "cooldown_days": {
              "type": "number",
              "default": 15
            },
            "alert_owner": {
              "type": "boolean",
              "default": true
            },
            "message": {
              "type": "string"
            }
          }
        },
        "fiel_sem_plano": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "cooldown_days": {
              "type": "number",
              "default": 45
            },
            "message": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "required": [
    "name"
  ]
}
{
  "name": "SlotReservation",
  "type": "object",
  "description": "Lock tempor\u00e1rio para evitar double-booking. Vida \u00fatil curta (90s default). Ver docs/RACE_CONDITIONS.md \u00a71.",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "unit_id": {
      "type": "string",
      "description": "Unidade onde o slot est\u00e1 sendo reservado. Opcional."
    },
    "professional_id": {
      "type": "string"
    },
    "scheduled_at": {
      "type": "string",
      "format": "date-time",
      "description": "Hor\u00e1rio exato (truncado para o minuto) que est\u00e1 sendo reservado."
    },
    "slot_key": {
      "type": "string",
      "description": "Chave composta company_id:professional_id:iso_minute. Usada para busca r\u00e1pida de conflito."
    },
    "owner_phone": {
      "type": "string",
      "description": "Telefone normalizado do cliente p\u00fablico (para permitir reuse pelo mesmo cliente trocando pix\u2194card)."
    },
    "reservation_owner_id": {
      "type": "string",
      "description": "ID l\u00f3gico do dono (customer_id se j\u00e1 conhecido, ou hash do telefone). Permite retomar reservation entre requests."
    },
    "source": {
      "type": "string",
      "enum": [
        "public_booking_pix",
        "public_booking_card",
        "public_booking_plan",
        "public_booking_free",
        "internal"
      ],
      "description": "De onde a reserva veio. \u00datil para auditoria e m\u00e9tricas."
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Quando o lock expira automaticamente. Reservas com expires_at < now s\u00e3o consideradas mortas."
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "consumed",
        "expired",
        "released"
      ],
      "default": "active",
      "description": "active = lock vigente. consumed = appointment criado. expired = TTL passou. released = liberado explicitamente (cancelamento)."
    },
    "appointment_id": {
      "type": "string",
      "description": "ID do Appointment criado quando status=consumed. Preenchido somente ap\u00f3s sucesso."
    },
    "consumed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "company_id",
    "professional_id",
    "scheduled_at",
    "slot_key",
    "expires_at"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "is_super_admin": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "is_super_admin": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "is_super_admin": true
          }
        }
      ]
    }
  }
}
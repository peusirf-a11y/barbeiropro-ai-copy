{
  "name": "User",
  "type": "object",
  "properties": {
    "is_super_admin": {
      "type": "boolean",
      "default": false,
      "description": "Acesso total ao Master Panel (cross-tenant)"
    },
    "totp_secret": {
      "type": "string",
      "description": "Segredo TOTP base32 (apenas super admin)"
    },
    "totp_enabled": {
      "type": "boolean",
      "default": false
    },
    "totp_last_code": {
      "type": "string",
      "description": "\u00daltimo c\u00f3digo TOTP consumido (anti-replay)"
    },
    "preferred_theme": {
      "type": "string",
      "enum": [
        "dark",
        "light",
        "system"
      ],
      "default": "system",
      "description": "Prefer\u00eancia de tema do usu\u00e1rio. 'system' = segue o SO; salvo via base44.auth.updateMe()."
    }
  },
  "required": [
    "totp_secret",
    "totp_last_code"
  ]
}
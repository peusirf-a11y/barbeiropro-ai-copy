{
  "name": "User",
  "type": "object",
  "properties": {
    "is_super_admin": {
      "type": "boolean",
      "default": false,
      "description": "Super Admin do BarberTrimly (acesso ao /master). Diferente de role=admin."
    },
    "totp_secret": {
      "type": "string",
      "description": "Segredo TOTP base32 do super admin (criptografado seria ideal, mas o Base44 j\u00e1 protege o storage)"
    },
    "totp_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Indica se o TOTP foi confirmado/ativado para este usu\u00e1rio"
    }
  }
}
{
  "name": "CustomerSubscription",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "plan_id": {
      "type": "string"
    },
    "plan_name_snapshot": {
      "type": "string",
      "description": "Snapshot do nome do plano no momento da assinatura"
    },
    "plan_price_snapshot": {
      "type": "number",
      "description": "Snapshot do pre\u00e7o mensal no momento da assinatura"
    },
    "plan_type_snapshot": {
      "type": "string",
      "enum": [
        "limited",
        "unlimited"
      ]
    },
    "plan_usage_limit_snapshot": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_payment",
        "active",
        "paused",
        "canceled"
      ],
      "default": "active",
      "description": "pending_payment = cliente assinou pelo link p\u00fablico mas barbearia ainda n\u00e3o confirmou pagamento."
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "current_cycle_start": {
      "type": "string",
      "format": "date-time",
      "description": "In\u00edcio do ciclo atual (mensal)"
    },
    "current_cycle_end": {
      "type": "string",
      "format": "date-time",
      "description": "Fim do ciclo atual / pr\u00f3xima cobran\u00e7a"
    },
    "uses_remaining": {
      "type": "number",
      "description": "Usos dispon\u00edveis no ciclo atual. Sempre 9999 quando type=unlimited."
    },
    "uses_consumed_total": {
      "type": "number",
      "default": 0,
      "description": "Total de usos consumidos desde o in\u00edcio (telemetria)"
    },
    "last_payment_status": {
      "type": "string",
      "enum": [
        "pago",
        "pendente",
        "atrasado"
      ],
      "default": "pendente"
    },
    "last_payment_at": {
      "type": "string",
      "format": "date-time"
    },
    "canceled_at": {
      "type": "string",
      "format": "date-time"
    },
    "paused_at": {
      "type": "string",
      "format": "date-time"
    },
    "stripe_subscription_id": {
      "type": "string",
      "description": "Legado Stripe Connect (Etapa pr\u00e9-Asaas). Mantido apenas para leitura/reconcilia\u00e7\u00e3o."
    },
    "stripe_customer_id": {
      "type": "string",
      "description": "Legado Stripe Connect. Mantido apenas para leitura/reconcilia\u00e7\u00e3o."
    },
    "asaas_subscription_id": {
      "type": "string",
      "description": "ID da subscription recorrente do cliente final no Asaas (assinatura de plano da barbearia)."
    },
    "asaas_customer_id": {
      "type": "string",
      "description": "ID do Customer Asaas representando o cliente final. Idempotente por customerId Base44."
    },
    "asaas_invoice_url": {
      "type": "string",
      "description": "URL da invoice/checkout cart\u00e3o mais recente do Asaas. Usado para retomar pagamento se o cliente fechou a aba."
    },
    "self_service_signup": {
      "type": "boolean",
      "default": false,
      "description": "Cliente assinou sozinho pelo link p\u00fablico (vs criada pela barbearia)."
    }
  },
  "required": [
    "company_id",
    "customer_id",
    "plan_id"
  ]
}
{
  "name": "FeatureFlag",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Identificador \u00fanico da flag (ex: whatsapp_automation, ai_growth)"
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "description": {
      "type": "string"
    },
    "scope": {
      "type": "string",
      "enum": [
        "global",
        "plan",
        "company"
      ],
      "default": "global",
      "description": "Escopo da flag: global (todos), plan (planos espec\u00edficos) ou company (empresas espec\u00edficas)"
    },
    "target_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs alvo conforme o scope (Plan.id ou Company.id). Vazio quando scope=global."
    }
  },
  "required": [
    "key"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "is_super_admin": true
      }
    },
    "read": {
      "user_condition": {
        "is_super_admin": true
      }
    },
    "update": {
      "user_condition": {
        "is_super_admin": true
      }
    },
    "delete": {
      "user_condition": {
        "is_super_admin": true
      }
    }
  }
}
{
  "name": "Unit",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "description": "Nome da unidade (ex: Matriz, Filial Centro, Loja Shopping)"
    },
    "slug": {
      "type": "string",
      "description": "Slug opcional para link p\u00fablico espec\u00edfico da unidade"
    },
    "address": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "whatsapp": {
      "type": "string"
    },
    "business_hours": {
      "type": "object",
      "description": "Hor\u00e1rios de funcionamento espec\u00edficos desta unidade (sobrescreve o da Company quando definido)"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "is_default": {
      "type": "boolean",
      "default": false,
      "description": "Marcador da Matriz (criada pelo backfill). Usada como default quando o usu\u00e1rio n\u00e3o tem unidade selecionada."
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "company_id",
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "is_super_admin": true
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "is_super_admin": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "is_super_admin": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "is_super_admin": true
          }
        }
      ]
    }
  }
}
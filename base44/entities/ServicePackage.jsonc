{
  "name": "ServicePackage",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "service_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "price": {
      "type": "number"
    },
    "duration_minutes": {
      "type": "number",
      "description": "Dura\u00e7\u00e3o total do combo em minutos (somat\u00f3rio dos servi\u00e7os ou customizado)"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "featured": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "company_id",
    "name",
    "price"
  ]
}
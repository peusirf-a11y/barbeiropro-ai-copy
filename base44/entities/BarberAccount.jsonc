{
  "name": "BarberAccount",
  "type": "object",
  "description": "Conta de dono/gestor de barbearia autentic\u00e1vel pelo sistema pr\u00f3prio do O CORTE (independente do Base44 Auth). Cada Company tem 1 owner + N managers (futuro). Reset de senha incrementa token_version \u2192 invalida todas as sess\u00f5es.",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Tenant ao qual a conta pertence. Sempre obrigat\u00f3rio."
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email \u00fanico por barbearia (case-insensitive \u2014 sempre salvo em lowercase). Usado para login."
    },
    "name": {
      "type": "string",
      "description": "Nome completo do dono/gestor."
    },
    "role": {
      "type": "string",
      "enum": [
        "owner",
        "manager"
      ],
      "default": "owner",
      "description": "owner = dono da barbearia (criado no checkout). manager = futuro, convidado pelo dono."
    },
    "password_hash": {
      "type": "string",
      "description": "Hash PBKDF2-SHA256 (600k itera\u00e7\u00f5es) + pepper. Vazio = conta criada mas senha ainda n\u00e3o definida (p\u00f3s-checkout). Nunca retornado ao frontend."
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Soft-disable da conta (admin pode desativar sem deletar)."
    },
    "email_verified": {
      "type": "boolean",
      "default": false,
      "description": "True ap\u00f3s o usu\u00e1rio clicar no link de ativa\u00e7\u00e3o e definir senha pela primeira vez."
    },
    "activation_token": {
      "type": "string",
      "description": "Token opaco enviado por email p\u00f3s-checkout para definir a primeira senha. Expira em 24h. Limpo ap\u00f3s uso."
    },
    "activation_token_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "reset_token": {
      "type": "string",
      "description": "Token opaco para redefinir senha quando esquecida. Expira em 1h. Limpo ap\u00f3s uso."
    },
    "reset_token_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "session_token": {
      "type": "string",
      "description": "Token opaco de sess\u00e3o atual (32 bytes hex). Rotacionado a cada login e reset. NUNCA retornar ao frontend ap\u00f3s gera\u00e7\u00e3o inicial."
    },
    "session_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Expira\u00e7\u00e3o da sess\u00e3o por inatividade (30 dias owner / 7 dias manager). Renovada em cada chamada autenticada."
    },
    "token_version": {
      "type": "number",
      "default": 0,
      "description": "Vers\u00e3o da sess\u00e3o. Incrementar invalida todas as sess\u00f5es ativas (usado em reset de senha e 'sair de todos os dispositivos')."
    },
    "last_login_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_login_ip": {
      "type": "string"
    },
    "last_activity_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u00daltima requisi\u00e7\u00e3o autenticada bem-sucedida. Usado para calcular expira\u00e7\u00e3o por inatividade."
    },
    "last_user_agent": {
      "type": "string"
    },
    "password_changed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "company_id",
    "email",
    "name"
  ]
}
{
  "name": "Plan",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do plano (ex: Starter, Pro, Enterprise)"
    },
    "price_monthly": {
      "type": "number",
      "description": "Pre\u00e7o mensal em R$"
    },
    "stripe_price_id": {
      "type": "string",
      "description": "Stripe Price ID associado (recurring monthly)"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "price_monthly"
  ]
}
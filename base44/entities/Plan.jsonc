{
  "name": "Plan",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do plano (ex: Starter, Pro, Enterprise)"
    },
    "price_monthly": {
      "type": "number",
      "description": "Pre\u00e7o mensal em R$"
    },
    "stripe_price_id": {
      "type": "string",
      "description": "Stripe Price ID associado (recurring monthly)"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista de features liberadas (ex: 'financial', 'commissions', 'ai_growth', 'reports')"
    },
    "limits": {
      "type": "object",
      "description": "Limites do plano",
      "properties": {
        "barbers": {
          "type": "number",
          "description": "M\u00e1x. profissionais ativos"
        },
        "appointments_month": {
          "type": "number",
          "description": "M\u00e1x. agendamentos/m\u00eas"
        },
        "storage_mb": {
          "type": "number",
          "description": "Storage em MB"
        }
      }
    }
  },
  "required": [
    "name",
    "price_monthly"
  ]
}
{
  "name": "BarberCredential",
  "type": "object",
  "description": "Credencial de login com senha do dono/gestor da barbearia. Convive com a auth Base44: n\u00f3s validamos o hash da senha localmente e usamos uma senha t\u00e9cnica (random_password_hint) para finalizar o login na plataforma Base44 e emitir o token de sess\u00e3o.",
  "properties": {
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email do dono (normalizado em min\u00fasculo)."
    },
    "company_id": {
      "type": "string",
      "description": "Empresa vinculada (snapshot no momento da cria\u00e7\u00e3o)."
    },
    "password_hash": {
      "type": "string",
      "description": "Hash PBKDF2-SHA256 da senha + pepper. Nunca armazenamos texto puro."
    },
    "password_salt": {
      "type": "string",
      "description": "Salt \u00fanico por credencial (base64)."
    },
    "password_algo": {
      "type": "string",
      "default": "pbkdf2-sha256-310000",
      "description": "Algoritmo + itera\u00e7\u00f5es usados no hash. Permite rota\u00e7\u00e3o futura."
    },
    "base44_password_hint": {
      "type": "string",
      "description": "Senha t\u00e9cnica aleat\u00f3ria usada para autenticar contra a Base44 internamente. NUNCA \u00e9 exposta ao usu\u00e1rio. O dono enxerga s\u00f3 a senha p\u00fablica (validada pelo password_hash)."
    },
    "failed_attempts": {
      "type": "number",
      "default": 0,
      "description": "Contador de falhas consecutivas de login. Resetado em login bem-sucedido."
    },
    "locked_until": {
      "type": "string",
      "format": "date-time",
      "description": "Quando setado, login bloqueado at\u00e9 este timestamp."
    },
    "last_login_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_login_ip": {
      "type": "string"
    }
  },
  "required": [
    "email",
    "password_hash",
    "password_salt"
  ]
}
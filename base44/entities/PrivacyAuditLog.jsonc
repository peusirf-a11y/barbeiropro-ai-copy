{
  "name": "PrivacyAuditLog",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Tenant da a\u00e7\u00e3o. NULL = a\u00e7\u00e3o de plataforma."
    },
    "customer_id": {
      "type": "string",
      "description": "Cliente alvo da a\u00e7\u00e3o (quando aplic\u00e1vel)"
    },
    "actor_email": {
      "type": "string",
      "description": "E-mail do ator humano (admin/staff que executou a a\u00e7\u00e3o)"
    },
    "actor_type": {
      "type": "string",
      "enum": [
        "admin",
        "staff",
        "customer_self",
        "system",
        "super_admin"
      ],
      "description": "Quem executou a a\u00e7\u00e3o"
    },
    "action": {
      "type": "string",
      "enum": [
        "DATA_EXPORT_REQUESTED",
        "DATA_EXPORT_DOWNLOADED",
        "DATA_ANONYMIZED",
        "CONSENT_GRANTED",
        "CONSENT_REVOKED",
        "SENSITIVE_DATA_VIEWED",
        "CUSTOMER_DATA_ACCESSED",
        "CUSTOMER_DELETED",
        "IMPERSONATION_STARTED",
        "IMPERSONATION_ENDED",
        "RETENTION_CLEANUP_RUN",
        "MARKETING_SENT_WITHOUT_CONSENT"
      ],
      "description": "Tipo de a\u00e7\u00e3o de privacidade executada"
    },
    "details": {
      "type": "object",
      "description": "Detalhes adicionais da a\u00e7\u00e3o (ex: campos anonimizados, tipo de consentimento, etc.)"
    },
    "ip_address": {
      "type": "string"
    },
    "user_agent": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "critical"
      ],
      "default": "info"
    }
  },
  "required": [
    "action"
  ]
}
{
  "name": "Appointment",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "unit_id": {
      "type": "string",
      "description": "Unidade onde o agendamento ocorre. Em mono-unidade, fica vazio ou aponta para a Matriz."
    },
    "customer_id": {
      "type": "string"
    },
    "professional_id": {
      "type": "string"
    },
    "service_id": {
      "type": "string"
    },
    "service_name": {
      "type": "string"
    },
    "professional_name": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "customer_email": {
      "type": "string",
      "format": "email"
    },
    "scheduled_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "agendado",
        "confirmado",
        "em_atendimento",
        "concluido",
        "cancelado",
        "faltou"
      ],
      "default": "agendado"
    },
    "notes": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "online",
        "interno"
      ],
      "default": "interno"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "price": {
      "type": "number"
    },
    "custom_duration_minutes": {
      "type": "number",
      "description": "Dura\u00e7\u00e3o customizada em minutos. Quando definida, sobrescreve a dura\u00e7\u00e3o padr\u00e3o do servi\u00e7o (usado em resize manual na agenda)."
    },
    "confirmation_email_sent": {
      "type": "boolean",
      "default": false
    },
    "confirm_token": {
      "type": "string",
      "description": "Token p\u00fablico para confirma\u00e7\u00e3o 1-clique via WhatsApp"
    },
    "review_token": {
      "type": "string",
      "description": "Token p\u00fablico para avalia\u00e7\u00e3o p\u00f3s-atendimento via WhatsApp"
    },
    "confirm_token_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "review_token_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "confirmed_at": {
      "type": "string",
      "format": "date-time"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "commission_created": {
      "type": "boolean",
      "default": false,
      "description": "Marcador idempotente para evitar comiss\u00e3o duplicada"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "avulso",
        "subscription"
      ],
      "default": "avulso",
      "description": "Forma de pagamento: avulso (pago no atendimento) ou subscription (consome plano do cliente)"
    },
    "subscription_id": {
      "type": "string",
      "description": "Quando payment_method=subscription, ID da CustomerSubscription que cobriu o atendimento"
    }
  },
  "required": [
    "company_id",
    "professional_id",
    "service_id",
    "scheduled_at"
  ]
}
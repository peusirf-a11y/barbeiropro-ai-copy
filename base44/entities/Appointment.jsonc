{
  "name": "Appointment",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "professional_id": {
      "type": "string"
    },
    "service_id": {
      "type": "string"
    },
    "service_name": {
      "type": "string"
    },
    "professional_name": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "customer_email": {
      "type": "string",
      "format": "email"
    },
    "scheduled_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "agendado",
        "confirmado",
        "em_atendimento",
        "concluido",
        "cancelado",
        "faltou"
      ],
      "default": "agendado"
    },
    "notes": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "online",
        "interno"
      ],
      "default": "interno"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "price": {
      "type": "number"
    },
    "confirmation_email_sent": {
      "type": "boolean",
      "default": false
    },
    "confirm_token": {
      "type": "string",
      "description": "Token p\u00fablico para confirma\u00e7\u00e3o 1-clique via WhatsApp"
    },
    "review_token": {
      "type": "string",
      "description": "Token p\u00fablico para avalia\u00e7\u00e3o p\u00f3s-atendimento via WhatsApp"
    },
    "confirm_token_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Expira\u00e7\u00e3o do token de confirma\u00e7\u00e3o (geralmente 24h antes do hor\u00e1rio)"
    },
    "review_token_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Expira\u00e7\u00e3o do token de avalia\u00e7\u00e3o (72h ap\u00f3s atendimento)"
    },
    "confirmed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora em que o cliente confirmou via link p\u00fablico"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora em que o cliente avaliou via link p\u00fablico"
    },
    "commission_created": {
      "type": "boolean",
      "default": false,
      "description": "Marcador idempotente para evitar comiss\u00e3o duplicada"
    }
  },
  "required": [
    "company_id",
    "professional_id",
    "service_id",
    "scheduled_at"
  ]
}
{
  "name": "Appointment",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "unit_id": {
      "type": "string",
      "description": "Unidade onde o agendamento ocorre."
    },
    "customer_id": {
      "type": "string"
    },
    "professional_id": {
      "type": "string"
    },
    "service_id": {
      "type": "string"
    },
    "service_name": {
      "type": "string"
    },
    "professional_name": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "customer_email": {
      "type": "string",
      "format": "email"
    },
    "scheduled_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "aguardando_pagamento",
        "agendado",
        "confirmado",
        "em_atendimento",
        "concluido",
        "cancelado",
        "faltou"
      ],
      "default": "agendado"
    },
    "notes": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "online",
        "interno"
      ],
      "default": "interno"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "price": {
      "type": "number"
    },
    "custom_duration_minutes": {
      "type": "number",
      "description": "Dura\u00e7\u00e3o customizada em minutos."
    },
    "confirmation_email_sent": {
      "type": "boolean",
      "default": false
    },
    "confirm_token": {
      "type": "string",
      "description": "Token p\u00fablico para confirma\u00e7\u00e3o 1-clique via WhatsApp"
    },
    "review_token": {
      "type": "string",
      "description": "Token p\u00fablico para avalia\u00e7\u00e3o p\u00f3s-atendimento via WhatsApp"
    },
    "confirm_token_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "review_token_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "confirmed_at": {
      "type": "string",
      "format": "date-time"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "commission_created": {
      "type": "boolean",
      "default": false,
      "description": "Marcador idempotente para evitar comiss\u00e3o duplicada"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "avulso",
        "subscription",
        "pix",
        "card"
      ],
      "default": "avulso",
      "description": "Forma de pagamento. pix/card = pagamento online via Stripe Connect."
    },
    "subscription_id": {
      "type": "string",
      "description": "Quando payment_method=subscription, ID da CustomerSubscription que cobriu o atendimento"
    },
    "paid": {
      "type": "boolean",
      "default": false,
      "description": "Marca\u00e7\u00e3o paralela ao status indicando que o pagamento foi recebido (presencial, Pix, m\u00e1quina, etc.). Independente de paid_online (que \u00e9 exclusivo do Stripe)."
    },
    "paid_at": {
      "type": "string",
      "format": "date-time",
      "description": "Quando o pagamento foi marcado como recebido."
    },
    "paid_online": {
      "type": "boolean",
      "default": false,
      "description": "True quando o agendamento foi pago via link p\u00fablico (Stripe). \u00datil para relat\u00f3rios e m\u00e9tricas de convers\u00e3o."
    },
    "payment_intent_id": {
      "type": "string",
      "description": "ID do PaymentIntent do Stripe vinculado a este agendamento (quando paid_online=true)."
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "pending",
        "succeeded",
        "failed",
        "canceled",
        "expired"
      ],
      "description": "Status do pagamento online. Sincronizado pelo webhook do Stripe."
    },
    "payment_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Prazo limite para o cliente concluir o pagamento (15 min ap\u00f3s cria\u00e7\u00e3o). Job limpa appointments expirados."
    },
    "payment_idempotency_key": {
      "type": "string",
      "description": "Chave determin\u00edstica para evitar duplicidade de PaymentIntent (refresh, duplo-clique)."
    },
    "payer_tax_id": {
      "type": "string",
      "description": "CPF do pagador (necess\u00e1rio para Pix). N\u00e3o persistido ap\u00f3s pagamento conclu\u00eddo."
    }
  },
  "required": [
    "company_id",
    "professional_id",
    "service_id",
    "scheduled_at"
  ],
  "rls": {
    "create": null,
    "update": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "is_super_admin": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "is_super_admin": true
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "is_super_admin": true
          }
        }
      ]
    }
  }
}
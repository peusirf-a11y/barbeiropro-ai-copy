{
  "name": "Customer",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "unit_id": {
      "type": "string",
      "description": "Unidade vinculada ao cliente. Usado apenas quando Company.customers_shared_across_units=false. Quando shared=true, fica vazio e o cliente pertence \u00e0 barbearia inteira."
    },
    "name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "total_appointments": {
      "type": "number",
      "default": 0
    },
    "last_appointment_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data do \u00faltimo atendimento CONCLU\u00cdDO. Fonte da verdade para c\u00e1lculo de lifecycle (em risco/inativo/perdido). Atualizado pelo onAppointmentConcluded."
    },
    "favorite_service": {
      "type": "string"
    },
    "favorite_professional": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "vip"
      ],
      "default": "active",
      "description": "Camada manual de relacionamento. 'vip' \u00e9 uma marca premium aprovada pela barbearia. 'inactive' \u00e9 uso legado/manual. O ciclo de vida autom\u00e1tico fica em lifecycle_status."
    },
    "lifecycle_status": {
      "type": "string",
      "enum": [
        "primeira_visita",
        "fiel",
        "em_risco",
        "inativo",
        "perdido"
      ],
      "description": "Status autom\u00e1tico calculado pelo sistema com base em last_completed_at e total de atendimentos conclu\u00eddos. Recalculado on-conclude e por job di\u00e1rio. Independente do campo 'status' (que controla VIP manual)."
    },
    "lifecycle_updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u00daltima vez que lifecycle_status foi recalculado."
    },
    "vip_dismissed_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u00daltima vez que o dono dispensou a sugest\u00e3o de VIP para este cliente. Suprime a sugest\u00e3o por 60 dias."
    },
    "password_hash": {
      "type": "string",
      "description": "Hash bcrypt da senha do cliente (\u00e1rea p\u00fablica). Vazio = cliente nunca criou conta."
    },
    "auth_token": {
      "type": "string",
      "description": "Token de sess\u00e3o atual do cliente (\u00fanico por dispositivo). Renovado a cada login."
    },
    "auth_token_expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "company_id",
    "name",
    "phone"
  ]
}
{
  "name": "Referral",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Empresa que criou (referrer)"
    },
    "code": {
      "type": "string",
      "description": "C\u00f3digo p\u00fablico \u00fanico do link de indica\u00e7\u00e3o"
    },
    "referred_email": {
      "type": "string",
      "description": "E-mail da empresa indicada quando ela se cadastra"
    },
    "referred_company_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "redeemed",
        "rewarded"
      ],
      "default": "pending"
    },
    "reward_type": {
      "type": "string",
      "enum": [
        "extra_trial_days",
        "feature_unlock",
        "credit"
      ],
      "default": "extra_trial_days"
    },
    "reward_value": {
      "type": "number",
      "default": 7,
      "description": "Dias extras de trial / valor de cr\u00e9dito / id da feature"
    },
    "redeemed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "company_id",
    "code"
  ]
}
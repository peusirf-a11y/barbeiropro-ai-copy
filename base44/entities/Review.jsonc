{
  "name": "Review",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "appointment_id": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "professional_id": {
      "type": "string"
    },
    "professional_name": {
      "type": "string"
    },
    "service_name": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "comment": {
      "type": "string"
    },
    "published": {
      "type": "boolean",
      "default": false,
      "description": "Avalia\u00e7\u00f5es come\u00e7am ocultas e precisam ser aprovadas pelo dono"
    },
    "moderated_at": {
      "type": "string",
      "format": "date-time"
    },
    "moderated_by": {
      "type": "string"
    }
  },
  "required": [
    "company_id",
    "rating"
  ]
}
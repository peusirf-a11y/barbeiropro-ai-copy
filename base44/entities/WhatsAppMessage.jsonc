{
  "name": "WhatsAppMessage",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "unit_id": {
      "type": "string",
      "description": "Unidade associada ao envio. Propagado a partir do Appointment ou do Customer quando relevante."
    },
    "customer_id": {
      "type": "string"
    },
    "appointment_id": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "confirmacao",
        "lembrete_24h",
        "lembrete_2h",
        "pos_atendimento",
        "reativacao",
        "crm_primeira_visita",
        "crm_em_risco",
        "crm_inativo",
        "crm_perdido",
        "crm_vip_inativo",
        "crm_fiel_sem_plano"
      ],
      "description": "Tipo de mensagem autom\u00e1tica. crm_* s\u00e3o campanhas baseadas em lifecycle_status (Fase 3)."
    },
    "message_text": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "enviado",
        "erro",
        "simulado"
      ],
      "default": "enviado"
    },
    "error_message": {
      "type": "string"
    },
    "provider_response": {
      "type": "object"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "idempotency_key": {
      "type": "string",
      "description": "Chave determin\u00edstica que identifica univocamente uma mensagem (A8 \u2014 Sprint A). Formato t\u00edpico: `${type}:${appointment_id|customer_id}:${bucket}`. Usada para deduplicar disparos em jobs/automa\u00e7\u00f5es que rodam mais de uma vez. Sempre que poss\u00edvel, o caller deve enviar esta chave."
    }
  },
  "required": [
    "company_id",
    "phone",
    "type"
  ],
  "rls": {
    "create": {
      "data.company_id": "{{user.data.company_id}}"
    },
    "read": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "is_super_admin": true
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "is_super_admin": true
      }
    },
    "delete": {
      "user_condition": {
        "is_super_admin": true
      }
    }
  }
}
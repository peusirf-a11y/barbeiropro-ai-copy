{
  "name": "CashRegister",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "unit_id": {
      "type": "string",
      "description": "Unidade dona deste caixa. Caixas legados sem unit_id continuam compat\u00edveis."
    },
    "opened_at": {
      "type": "string",
      "format": "date-time"
    },
    "closed_at": {
      "type": "string",
      "format": "date-time"
    },
    "initial_amount": {
      "type": "number",
      "default": 0
    },
    "final_amount": {
      "type": "number"
    },
    "expected_amount": {
      "type": "number",
      "description": "Saldo esperado calculado pelo sistema (inicial + entradas - sa\u00eddas - sangrias + suprimentos)"
    },
    "difference": {
      "type": "number",
      "description": "Diferen\u00e7a entre final_amount e expected_amount (sobra/falta)"
    },
    "total_in": {
      "type": "number",
      "description": "Snapshot: total de entradas no momento do fechamento."
    },
    "total_out": {
      "type": "number",
      "description": "Snapshot: total de sa\u00eddas no momento do fechamento."
    },
    "total_sangria": {
      "type": "number",
      "description": "Snapshot: total de sangrias (retirada de dinheiro) no fechamento."
    },
    "total_suprimento": {
      "type": "number",
      "description": "Snapshot: total de suprimentos (refor\u00e7o de caixa) no fechamento."
    },
    "payment_breakdown": {
      "type": "object",
      "description": "Snapshot do total por forma de pagamento no fechamento. Ex: { dinheiro: 350, pix: 220, cartao_credito: 100 }"
    },
    "status": {
      "type": "string",
      "enum": [
        "aberto",
        "fechando",
        "fechado"
      ],
      "default": "aberto",
      "description": "Ciclo de vida do caixa. 'fechando' \u00e9 estado intermedi\u00e1rio curto (< 5s t\u00edpico) usado para evitar race entre fechamento e novos lan\u00e7amentos (P0.3). Ver docs/RACE_CONDITIONS.md \u00a73."
    },
    "closing_started_at": {
      "type": "string",
      "format": "date-time",
      "description": "Quando o claim at\u00f4mico aberto\u2192fechando foi feito. Usado pelo job repairStuckCashRegisters para detectar caixas presos (> 5min)."
    },
    "closing_by": {
      "type": "string",
      "description": "Email do usu\u00e1rio que iniciou o fechamento (claim do lock)."
    },
    "opened_by": {
      "type": "string"
    },
    "closed_by": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "metadata": {
      "type": "object",
      "description": "Espa\u00e7o aberto para fases futuras (TEF, concilia\u00e7\u00e3o, etc.)"
    }
  },
  "required": [
    "company_id",
    "opened_at",
    "initial_amount"
  ],
  "rls": {
    "create": {
      "data.company_id": "{{user.data.company_id}}"
    },
    "read": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "is_super_admin": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "is_super_admin": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "is_super_admin": true
          }
        }
      ]
    }
  }
}
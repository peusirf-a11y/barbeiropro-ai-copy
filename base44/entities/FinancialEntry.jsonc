{
  "name": "FinancialEntry",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "unit_id": {
      "type": "string",
      "description": "Unidade onde a movimenta\u00e7\u00e3o ocorreu. Lan\u00e7amentos legados sem unit_id seguem compat\u00edveis."
    },
    "cash_register_id": {
      "type": "string",
      "description": "Caixa ao qual a movimenta\u00e7\u00e3o pertence. Vazio = movimenta\u00e7\u00e3o fora do caixa (legado)."
    },
    "professional_id": {
      "type": "string",
      "description": "Profissional vinculado (quando aplic\u00e1vel, ex.: comiss\u00e3o, atendimento)."
    },
    "customer_id": {
      "type": "string",
      "description": "Cliente vinculado (quando aplic\u00e1vel, ex.: atendimento avulso, produto)."
    },
    "type": {
      "type": "string",
      "enum": [
        "entrada",
        "saida"
      ],
      "default": "entrada",
      "description": "Eixo cont\u00e1bil (mantido para compatibilidade). Sangria e suprimento usam entry_kind."
    },
    "entry_kind": {
      "type": "string",
      "enum": [
        "entrada",
        "saida",
        "sangria",
        "suprimento"
      ],
      "description": "Natureza operacional do lan\u00e7amento. Quando ausente, derivar de 'type' (legado)."
    },
    "origin": {
      "type": "string",
      "enum": [
        "agendamento",
        "produto",
        "assinatura",
        "manual",
        "comissao",
        "ajuste"
      ],
      "description": "De onde o lan\u00e7amento foi originado. Default operacional: 'manual'."
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "dinheiro",
        "pix",
        "cartao_credito",
        "cartao_debito",
        "link_pagamento",
        "carteira_digital"
      ],
      "description": "Forma de pagamento. Usado em entradas/sa\u00eddas. Sangria/suprimento podem omitir."
    },
    "category": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "confirmado"
      ],
      "default": "confirmado"
    },
    "reference_appointment_id": {
      "type": "string"
    },
    "justification": {
      "type": "string",
      "description": "Motivo/justificativa obrigat\u00f3ria em sangria e suprimento. Tamb\u00e9m usada como contexto adicional em ajustes."
    },
    "is_locked": {
      "type": "boolean",
      "default": false,
      "description": "Quando true, frontend n\u00e3o permite editar/excluir (origens 'agendamento' e 'comissao' devem vir locked)."
    },
    "edited_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u00daltima vez que o lan\u00e7amento foi editado."
    },
    "edited_by": {
      "type": "string",
      "description": "Email do usu\u00e1rio que editou pela \u00faltima vez."
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time",
      "description": "Quando setado, o lan\u00e7amento foi exclu\u00eddo (soft delete)."
    },
    "deleted_by": {
      "type": "string"
    },
    "deletion_reason": {
      "type": "string",
      "description": "Motivo informado ao excluir um lan\u00e7amento manual."
    },
    "metadata": {
      "type": "object",
      "description": "Campo livre para integra\u00e7\u00f5es futuras (TEF, NFC, split, etc.)"
    }
  },
  "required": [
    "company_id",
    "type",
    "amount",
    "date"
  ],
  "rls": {
    "create": {
      "data.company_id": "{{user.data.company_id}}"
    },
    "read": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "is_super_admin": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "is_super_admin": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "is_super_admin": true
          }
        }
      ]
    }
  }
}
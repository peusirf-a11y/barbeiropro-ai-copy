{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "actor_email": {
      "type": "string",
      "description": "E-mail do usu\u00e1rio que executou a a\u00e7\u00e3o"
    },
    "actor_is_super_admin": {
      "type": "boolean",
      "default": false
    },
    "impersonated_company_id": {
      "type": "string",
      "description": "Se a a\u00e7\u00e3o foi executada via impersona\u00e7\u00e3o, ID da empresa-alvo"
    },
    "action": {
      "type": "string",
      "description": "Identificador da a\u00e7\u00e3o (ex: BLOCK_COMPANY, ACTIVATE_COMPANY)"
    },
    "target_type": {
      "type": "string"
    },
    "target_id": {
      "type": "string"
    },
    "before": {
      "type": "object"
    },
    "after": {
      "type": "object"
    },
    "ip": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "action"
  ]
}
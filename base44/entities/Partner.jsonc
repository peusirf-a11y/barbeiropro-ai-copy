{
  "name": "Partner",
  "type": "object",
  "description": "Parceiro/Afiliado do programa de indica\u00e7\u00f5es. Indica novas barbearias e recebe comiss\u00e3o recorrente sobre a assinatura SaaS delas. Aprova\u00e7\u00e3o manual pelo Master.",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome completo do parceiro."
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email \u00fanico do parceiro. Usado como identidade no painel /parceiro."
    },
    "phone": {
      "type": "string",
      "description": "Telefone (somente d\u00edgitos) \u2014 usado para detec\u00e7\u00e3o de auto-indica\u00e7\u00e3o."
    },
    "cpf_cnpj": {
      "type": "string",
      "description": "CPF ou CNPJ (somente d\u00edgitos). Necess\u00e1rio para emiss\u00e3o de comiss\u00e3o e detec\u00e7\u00e3o de auto-indica\u00e7\u00e3o."
    },
    "pix_key": {
      "type": "string",
      "description": "Chave PIX usada para pagamento manual das comiss\u00f5es aprovadas."
    },
    "referral_code": {
      "type": "string",
      "description": "C\u00f3digo \u00fanico do parceiro (usado em ?ref=CODE). Gerado server-side, 8-12 chars."
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "suspended"
      ],
      "default": "pending",
      "description": "pending = aguardando aprova\u00e7\u00e3o do Master; active = pode receber indica\u00e7\u00f5es e gerar comiss\u00e3o; suspended = bloqueado."
    },
    "commission_percentage": {
      "type": "number",
      "default": 20,
      "description": "Percentual de comiss\u00e3o recorrente (0-100). Default 20%. Master pode editar por parceiro."
    },
    "approved_at": {
      "type": "string",
      "format": "date-time",
      "description": "Quando o Master aprovou o cadastro."
    },
    "approved_by": {
      "type": "string",
      "description": "Email do Master que aprovou."
    },
    "suspended_at": {
      "type": "string",
      "format": "date-time"
    },
    "suspended_by": {
      "type": "string"
    },
    "suspension_reason": {
      "type": "string"
    },
    "auth_token": {
      "type": "string",
      "description": "Token de sess\u00e3o (acesso ao painel /parceiro). Hash SHA-256 do token bruto."
    },
    "auth_token_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "magic_token": {
      "type": "string",
      "description": "Token passwordless enviado por email para acesso ao painel. Uso \u00fanico. Fallback caso o parceiro n\u00e3o lembre a senha."
    },
    "magic_token_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "password_hash": {
      "type": "string",
      "description": "Hash PBKDF2-SHA256 da senha + pepper. Nunca armazenamos texto puro. Login email+senha (mesmo padr\u00e3o de BarberCredential)."
    },
    "password_salt": {
      "type": "string",
      "description": "Salt \u00fanico por parceiro (base64)."
    },
    "password_algo": {
      "type": "string",
      "default": "pbkdf2-sha256-310000",
      "description": "Algoritmo + itera\u00e7\u00f5es usados no hash. Permite rota\u00e7\u00e3o futura."
    },
    "failed_attempts": {
      "type": "number",
      "default": 0,
      "description": "Contador de falhas consecutivas de login. Resetado em login bem-sucedido."
    },
    "locked_until": {
      "type": "string",
      "format": "date-time",
      "description": "Quando setado, login por senha bloqueado at\u00e9 este timestamp (ap\u00f3s 5 falhas)."
    },
    "last_login_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_login_ip": {
      "type": "string"
    },
    "reset_token_hash": {
      "type": "string",
      "description": "Hash SHA-256 do token de reset de senha. Salvamos s\u00f3 o hash \u2014 o token cru vai por email e nunca persiste."
    },
    "reset_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Quando o reset_token_hash expira (1 hora ap\u00f3s gera\u00e7\u00e3o)."
    },
    "reset_requested_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u00daltima vez que um reset foi solicitado (usado pra rate-limit de envio)."
    },
    "fingerprint_seen": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Device fingerprints registrados no cadastro/login do parceiro. Usado em anti-fraude para detectar auto-indica\u00e7\u00e3o."
    },
    "monthly_goal": {
      "type": "number",
      "description": "Meta mensal de comiss\u00f5es geradas (R$). Padr\u00e3o 1000. Master pode editar."
    },
    "notes": {
      "type": "string",
      "description": "Anota\u00e7\u00f5es internas do Master."
    }
  },
  "required": [
    "name",
    "email",
    "referral_code"
  ]
}
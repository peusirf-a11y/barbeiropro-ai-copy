{
  "name": "Auto Financial + Review on Concluded Appointment",
  "description": "Quando appointment muda para concluido, cria entrada financeira e envia link de avalia\u00e7\u00e3o no WhatsApp imediatamente. Idempotente.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"concluido\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Appointment"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_financial_review_on_concluded_appointment",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "onAppointmentConcluded",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "onAppointmentConcluded"
  }
}
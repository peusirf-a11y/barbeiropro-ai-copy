{
  "name": "Auto Commission on Concluded Appointment",
  "description": "Quando um agendamento muda para status=concluido, gera a comiss\u00e3o do profissional automaticamente. Idempotente via flag commission_created.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"concluido\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Appointment"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_commission_on_concluded_appointment",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "registerCommission",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "registerCommission"
  }
}